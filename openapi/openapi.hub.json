  "openapi": "3.1.0",
  "paths": {
    "/api/central/projects": {
      "get": {
        "description": "Projekte der Zentrale, die der Nutzer sehen darf – mit Markierung „schon hier“.",
        "operationId": "central_projects_api_central_projects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CentralProjects"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HubProblem"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Central Projects"
      }
    },
    "/api/hub": {
